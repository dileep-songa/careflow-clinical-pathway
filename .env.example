# ==============================================================================
# CareFlow Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (e.g. `cp .env.example .env`)
# 2. Replace the placeholder values below with your GCP project configuration.
# 3. DO NOT commit .env or any credentials/keys to Git (enforced in .gitignore).
# ==============================================================================

# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# BigQuery Dataset and Table Names
BIGQUERY_DATASET=careflow_raw
BIGQUERY_TABLE_RAW=hospital_events_raw

# Authentication
# Preferred: Google Cloud Application Default Credentials (ADC)
# Run: `gcloud auth application-default login`
#
# Alternative (Service Account Key File - store securely outside repository):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

