table pathway_variants_summary
	lineageTag: a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d

	measure 'Total Variant Cases' = SUM('pathway_variants_summary'[case_count])
		formatString: #,##0
		lineageTag: a2b3c4d5-e6f7-8a9b-0c1d-2e3f4a5b6c7d

	column variant_rank
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: variant_rank

	column case_count
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: case_count

	column percentage
		dataType: double
		formatString: 0.0"%"
		summarizeBy: none
		sourceColumn: percentage

	column pathway
		dataType: string
		summarizeBy: none
		sourceColumn: pathway

	partition pathway_variants_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\project\careflow-clinical-pathway\outputs\pathway_variants_summary.csv"),[Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"variant_rank", Int64.Type}, {"case_count", Int64.Type}, {"percentage", type number}, {"pathway", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
