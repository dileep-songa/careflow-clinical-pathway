            "sourceColumn": "percentage_difference",
            "summarizeBy": "none"
          },
          {
            "name": "unit",
            "dataType": "string",
            "lineageTag": "583f4ea4-3984-4af4-b367-7e600039990e",
            "sourceColumn": "unit",
            "summarizeBy": "none"
          },
          {
            "name": "provenance",
            "dataType": "string",
            "lineageTag": "799949f7-7b76-46e5-b6bd-aa5d020240b8",
            "sourceColumn": "provenance",
            "summarizeBy": "none"
          },
          {
            "name": "interpretation",
            "dataType": "string",
            "lineageTag": "46fd233c-c546-4851-9cf8-a5e8507b54cf",
            "sourceColumn": "interpretation",
