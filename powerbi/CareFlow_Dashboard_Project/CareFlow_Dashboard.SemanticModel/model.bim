            "sourceColumn": "previous_activity",
            "summarizeBy": "none"
          },
          {
            "name": "transition_minutes_from_previous",
            "dataType": "int64",
            "formatString": "#,##0",
            "lineageTag": "95f45a92-2f4c-4fda-9a91-adb891070be8",
            "sourceColumn": "transition_minutes_from_previous",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "16005fff-e9ff-454a-9d9b-826c68590aeb",
        "measures": [
          {
            "name": "Total Cases",
            "expression": "DISTINCTCOUNT('stg_hospital_events'[case_id])",
            "formatString": "#,##0",
            "lineageTag": "268e0df6-b01e-4525-b852-f217108b0841"
          },
          {
            "name": "Total Events",
            "expression": "COUNTROWS('stg_hospital_events')",
            "formatString": "#,##0",
            "lineageTag": "c6b88a5b-b73d-459c-85bc-a50867f9cd39"
          },
          {
            "name": "Avg Case Cycle Time (Mins)",
            "expression": [
              "AVERAGEX(",
              "    VALUES('stg_hospital_events'[case_id]),",
              "    CALCULATE(SUM('stg_hospital_events'[transition_minutes_from_previous]))",
              ")"
            ],
            "formatString": "0.0 \"mins\"",
            "lineageTag": "1138ea12-042b-4c0d-a572-4c546277a8c3"
          },
          {
            "name": "Median Case Cycle Time (Mins)",
            "expression": [
              "MEDIANX(",
              "    VALUES('stg_hospital_events'[case_id]),",
              "    CALCULATE(SUM('stg_hospital_events'[transition_minutes_from_previous]))",
              ")"
            ],
            "formatString": "0.0 \"mins\"",
            "lineageTag": "d4cfb71f-b7e6-4dba-a4d8-85abd6c80396"
          },
          {
            "name": "Re-Triage Rate %",
            "expression": [
              "VAR ReTriageCases =",
              "    CALCULATE(",
              "        DISTINCTCOUNT('stg_hospital_events'[case_id]),",
              "        'stg_hospital_events'[raw_activity_name] = \"Triage\",",
              "        'stg_hospital_events'[previous_activity] = \"Triage\"",
              "    )",
              "RETURN",
              "DIVIDE(ReTriageCases, [Total Cases], 0)"
            ],
            "formatString": "0.0%",
            "lineageTag": "345f49c1-6dcd-4120-b092-0a7484ca557d"
          },
          {
            "name": "Conformant Cases Count",
            "expression": "[Total Cases] - [Repeat Triage Cases Count]",
            "formatString": "#,##0",
            "lineageTag": "7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d"
          },
          {
            "name": "Repeat Triage Cases Count",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT('stg_hospital_events'[case_id]),",
              "    'stg_hospital_events'[raw_activity_name] = \"Triage\",",
              "    'stg_hospital_events'[previous_activity] = \"Triage\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e"
          },
          {
            "name": "Conformance Rate %",
            "expression": "DIVIDE([Conformant Cases Count], [Total Cases], 0)",
            "formatString": "0.0%",
            "lineageTag": "9c0d1e2f-3a4b-5c6d-7e8f-9a0b1c2d3e4f"
          },
          {
            "name": "Average Cycle Time",
            "expression": "[Avg Case Cycle Time (Mins)]",
            "formatString": "0.0 \"mins\"",
            "lineageTag": "7159ceba-afc2-485f-8f54-056d43eb1e0f"
          },
          {
            "name": "Median Cycle Time",
            "expression": "[Median Case Cycle Time (Mins)]",
            "formatString": "0.0 \"mins\"",
            "lineageTag": "87a0271f-fc22-4544-892a-6391e651f516"
          },
          {
            "name": "Repeat-Triage Rate",
            "expression": "[Re-Triage Rate %]",
            "formatString": "0.0%",
            "lineageTag": "2c0d644c-b35b-4eee-88e1-795353903018"
          },
          {
            "name": "Conformant Cases",
            "expression": "[Conformant Cases Count]",
            "formatString": "#,##0",
            "lineageTag": "e9367825-bfc6-41b3-9c92-0d8a1b3e3771"
          },
          {
            "name": "Repeat-Triage Cases",
            "expression": "[Repeat Triage Cases Count]",
            "formatString": "#,##0",
            "lineageTag": "7ce582b1-335e-4c7f-b030-04a0cb5eda41"
          },
          {
            "name": "Conformance Rate",
            "expression": "[Conformance Rate %]",
            "formatString": "0.0%",
            "lineageTag": "b0275b45-5f01-42d8-9220-acea292b0d2b"
          }
        ],
        "partitions": [
          {
            "name": "stg_hospital_events",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:\\project\\careflow-clinical-pathway\\data\\cleaned\\stg_hospital_events.csv\"),[Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Replaced Empty Strings\" = Table.ReplaceValue(#\"Promoted Headers\", \"\", null, Replacer.ReplaceValue, {\"previous_activity\", \"transition_minutes_from_previous\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Replaced Empty Strings\",{{\"case_id\", type text}, {\"event_sequence\", Int64.Type}, {\"raw_activity_name\", type text}, {\"activity_name\", type text}, {\"event_timestamp\", type datetime}, {\"event_date\", type date}, {\"department\", type text}, {\"resource_id\", type text}, {\"data_provenance\", type text}, {\"previous_activity\", type text}, {\"transition_minutes_from_previous\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
